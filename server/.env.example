PORT=3001
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
SQLITE_DB_PATH=./data/efcp.sqlite

# Production: set NODE_ENV=production and require strong JWT + explicit CORS (see server/README.md).
# NODE_ENV=production

# Comma-separated browser origins allowed to call this API (required when NODE_ENV=production).
# Example: https://app.yourdomain.com,https://www.yourdomain.com
# CORS_ORIGINS=

# Behind nginx/Render/Railway: set so rate limits and logs see the real client IP.
# TRUST_PROXY=1

# Login throttling (optional overrides).
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# LOGIN_RATE_LIMIT_MAX=30

# When unset or not "true", all /api/* routes (except /api/auth/login) require a valid Bearer JWT.
# Set to true only for trusted local/desktop use if you need the legacy "no token = first user" behavior.
# ALLOW_UNAUTHENTICATED_API=true

# Optional — Neon / Supabase / Railway Postgres. When set, the API uses this database instead of local SQLite.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

FIREBASE_VIEWER_SHOP_ID=efcp-main
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=../service-account.json
